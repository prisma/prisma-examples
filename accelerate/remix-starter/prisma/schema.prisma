generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgres"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Quotes {
  id        Int      @id @default(autoincrement())
  quote     String
  createdAt DateTime @default(now())
}
