generator client {
  provider   = "prisma-client"
  output     = "../shared/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuoteKind {
  Fact
  Opinion
}

model Quotes {
  id        Int       @id @default(autoincrement())
  quote     String
  kind      QuoteKind @default(Opinion)
  createdAt DateTime  @default(now())
}
