{
  "name": "prisma-compute-hono",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "bun run contract:emit && tsc",
    "start": "node dist/index.js",
    "contract:emit": "prisma contract emit",
    "migration:plan": "prisma migration plan",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:seed": "tsx src/prisma/seed.ts",
    "compute:login": "prisma auth login",
    "compute:database:create": "prisma postgres create prisma-compute-hono --branch main",
    "compute:connect": "prisma git connect",
    "compute:open": "prisma service open"
  },
  "dependencies": {
    "@hono/node-server": "2.0.4",
    "@prisma/composer": "0.16.0",
    "@prisma/composer-prisma-cloud": "0.16.0",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "dotenv": "17.4.2",
    "hono": "4.12.34"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.3.0",
    "@types/node": "24.12.4",
    "alchemy": "2.0.0-beta.74",
    "prisma": "8.0.0-rc.12",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
