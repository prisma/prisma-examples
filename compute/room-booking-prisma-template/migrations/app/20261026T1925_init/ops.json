    "execute": [
      {
        "description": "add exclusion constraint",
        "sql": "ALTER TABLE \"public\".\"Booking\" ADD CONSTRAINT \"booking_no_overlap\" EXCLUDE USING gist (\"roomId\" WITH =, tstzrange(\"startsAt\", \"endsAt\", '[)') WITH &&)"
