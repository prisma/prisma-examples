# Local settings for `npm run dev`, the db:* scripts and the tests.
# Copy this file to .env.local (not .env: `next build` copies .env into the
# bundle that `npm run deploy` uploads) and fill in your own values.
#
# Not needed for `npm run dev:composer`, which starts its own local database,
# or on Prisma Compute, where the app gets its database from Composer.

# Any PostgreSQL 15+ database. For a free temporary Prisma Postgres database,
# run `npx create-db@latest` and paste the connection string it prints.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rooms"

# Optional: a separate, disposable database for the integration tests
# (`npm test`). They delete its data. Use a real PostgreSQL server here.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rooms_test"
