---
import { render } from "astro:content";

import Base from "../../layouts/Base.astro";
import { getPublishedPosts } from "../../lib/blog";

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatter = new Intl.DateTimeFormat("en", { dateStyle: "long", timeZone: "UTC" });
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <header>
      <h1>{post.data.title}</h1>
      <time datetime={post.data.publishedAt.toISOString()}>
        {formatter.format(post.data.publishedAt)}
      </time>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>

  <p class="back"><a href="/blog">← All posts</a></p>
</Base>

<style>
  header {
    margin-bottom: 2rem;
  }

  h1 {
    margin: 0 0 0.375rem;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  time {
    color: var(--faint);
    font-size: 0.85rem;
  }

  .prose {
    font-size: 1rem;
  }

  .prose :global(h2) {
    margin: 2rem 0 0.75rem;
    font-size: 1.15rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .prose :global(p) {
    margin: 0 0 1rem;
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
  }

  .prose :global(pre) {
    padding: 0.875rem 1rem;
    border-radius: 0.5rem;
    background: var(--surface);
    overflow-x: auto;
    font-size: 0.85rem;
  }

  .prose :global(pre code) {
    padding: 0;
    background: none;
  }

  .prose :global(blockquote) {
    margin: 0 0 1rem;
    padding-left: 1rem;
    border-left: 2px solid var(--border);
    color: var(--muted);
  }

  .back {
    margin-top: 3rem;
  }

  .back a {
    color: var(--muted);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .back a:hover {
    color: var(--fg);
  }
</style>
