{
  "name": "dev-shelf-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "contract:emit": "prisma contract emit",
    "migration:plan": "prisma migration plan",
    "db:migrate": "prisma db migrate --yes",
    "db:seed": "tsx src/prisma/seed-cli.ts",
    "db:seed:bulk": "tsx src/prisma/seed-bulk.ts",
    "composer:dev": "prisma dev --entry module.ts",
    "composer:deploy": "prisma deploy --entry module.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/composer": "0.35.0",
    "@prisma/composer-prisma-cloud": "0.35.0",
    "@prisma/orm-postgres": "8.0.0-rc.20",
    "alchemy": "2.0.0-beta.83",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.67.0",
    "next": "16.4.4",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "temporal-polyfill": "^1.0.6",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.3",
    "@effect/platform-node": "4.0.3",
    "@effect/platform-node-shared": "4.0.3",
    "@prisma/dev": "0.25.2",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "prisma": "8.0.0-rc.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "effect": "4.0.3",
    "@effect/platform-bun": "4.0.3",
    "@effect/platform-node": "4.0.3",
    "@effect/platform-node-shared": "4.0.3",
    "@effect/sql-d1": "4.0.3",
    "@effect/sql-sqlite-do": "4.0.3",
    "@effect/vitest": "4.0.3",
    "@vitejs/devtools": "0.7.6"
  }
}
