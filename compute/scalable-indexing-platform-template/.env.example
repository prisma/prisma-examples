# Local settings for `bun run dev` and the db:* scripts.
# Copy this file to .env.local (not .env: `next build` copies .env into the
# bundle that a deploy uploads) and set your own value.
#
# Not needed on Prisma Compute or under `bun run composer:dev`, where the app
# gets its database from Prisma Composer.

# Any PostgreSQL 15+ database. For a free temporary Prisma Postgres database,
# run `bunx create-db@latest` and paste the connection string it prints.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devshelf"
