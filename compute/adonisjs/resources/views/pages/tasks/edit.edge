@layouts.app({ title: 'Rename task' })
  @page({ title: 'Rename task' })
    <div class="panel">
      @form({
        route: 'tasks.update',
        routeParams: [task.id],
        method: 'PUT',
        class: 'task-form',
      })
        @field.root({ name: 'title' })
          @!field.label({ text: 'Title', class: 'sr-only' })
          @!input.control({
            value: task.title,
            autocomplete: 'off',
            maxlength: 255,
            required: true,
          })
          @!field.error()
        @end
        @!button({ text: 'Save', type: 'submit' })
        @link({ route: 'tasks.index', class: 'btn btn--ghost' })
          Cancel
        @end
      @end
    </div>
  @end
@end
