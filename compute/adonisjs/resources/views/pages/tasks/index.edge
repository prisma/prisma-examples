@layouts.app({ title: 'Tasks' })
  @page({
    title: 'Tasks',
    description: 'Every task is a row in your Prisma Postgres database.',
  })
    <div class="panel">
      @form({ route: 'tasks.store', method: 'POST', class: 'task-form' })
        @field.root({ name: 'title' })
          @!field.label({ text: 'New task', class: 'sr-only' })
          @!input.control({
            placeholder: 'What needs doing?',
            autocomplete: 'off',
            maxlength: 255,
            required: true,
          })
          @!field.error()
        @end
        @!button({ text: 'Add task', type: 'submit' })
      @end

      @if(tasks.length)
        <ul class="tasks">
          @each(task in tasks)
            <li class="task {{ task.completed ? 'task--done' : '' }}">
              @form({ route: 'tasks.update', routeParams: [task.id], method: 'PUT' })
                <input type="hidden" name="completed" value="{{ task.completed ? 'false' : 'true' }}" />
                <button
                  type="submit"
                  class="iconbtn"
                  aria-label="{{ task.completed ? 'Mark as open' : 'Mark as done' }}"
                >
                  @if(task.completed)
                    @svg('lucide:circle-check-big', { width: 18, height: 18 })
                  @else
                    @svg('lucide:circle', { width: 18, height: 18 })
                  @end
                </button>
              @end

              <span class="task__title">{{ task.title }}</span>

              @link({
                route: 'tasks.edit',
                routeParams: [task.id],
                class: 'iconbtn',
                'aria-label': 'Rename task',
              })
                @svg('lucide:pencil', { width: 16, height: 16 })
              @end

              @form({ route: 'tasks.destroy', routeParams: [task.id], method: 'DELETE' })
                <button type="submit" class="iconbtn" aria-label="Delete task">
                  @svg('lucide:trash-2', { width: 16, height: 16 })
                </button>
              @end
            </li>
          @end
        </ul>
      @else
        <p class="tasks__empty">No tasks yet. Add your first one above.</p>
      @end
    </div>
  @end
@end
