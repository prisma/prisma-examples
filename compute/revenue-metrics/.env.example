# Local settings for `bun run dev` and the db:* scripts. Copy this file to
# .env.local (not .env: `next build` copies .env into the bundle that a deploy
# uploads) and set your own value. Not needed on Prisma Compute, where the app
# gets its database from Prisma Composer.
#
# With Prisma Postgres, use the direct host db.prisma.io. The pooled host
# (pooled.db.prisma.io) refuses a setting Prisma ORM 8 sends while connecting,
# until prisma/orm#31081 ships.
DATABASE_URL="postgresql://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
