// use prisma-8

// Stripe billing tables, with the same columns, types and nulls as the
// tables Codeless Sync (codelesssync.com) creates, so real Stripe data can be
// synced into them. Amounts are in minor units (cents). No foreign keys:
// synced rows can arrive in any order.

model StripeSubscription {
  id                     String    @id
  customer               String
  status                 String
  description            String?
  current_period_start   DateTime?
  current_period_end     DateTime?
  cancel_at_period_end   Boolean?  @default(false)
  canceled_at            DateTime?
  ended_at               DateTime?
  currency               String?
  default_payment_method String?
  data                   Jsonb?
  livemode               Boolean
  created                DateTime?
  synced_at              DateTime? @default(now())

  @@index([status])
  @@map("stripe_subscriptions")
}

model StripeSubscriptionItem {
  id           String   @id
  subscription String
  price_id     String?
  product_id   String?
  quantity     Int?     @default(1)
  data         Jsonb?
  livemode     Boolean
  created      DateTime
  synced_at    DateTime @default(now())

  @@index([subscription])
  @@map("stripe_subscription_items")
}

model StripePrice {
  id                       String   @id
  product                  String
  active                   Boolean? @default(true)
  currency                 String
  unit_amount              Int?
  type                     String
  recurring_interval       String?
  recurring_interval_count Int?
  data                     Jsonb?
  livemode                 Boolean
  created                  DateTime
  synced_at                DateTime @default(now())

  @@map("stripe_prices")
}

model StripeInvoice {
  id          String    @id
  customer    String
  description String?
  status      String
  total       Int?
  amount_paid Int?
  amount_due  Int?
  currency    String?
  data        Jsonb?
  livemode    Boolean
  created     DateTime?
  synced_at   DateTime? @default(now())

  @@index([status, created])
  @@map("stripe_invoices")
}
