    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.2.0",
    "@types/node": "24.12.4",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "alchemy": "2.0.0-beta.74",
    "prisma": "8.0.0-rc.11",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  }
