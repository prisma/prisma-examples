{
  "name": "prisma-compute-tanstack-start",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "compute:login": "prisma-cli auth login",
    "compute:env:add": "prisma-cli project env add DATABASE_URL --role production",
    "compute:env:update": "prisma-cli project env update DATABASE_URL --role production",
    "compute:deploy": "prisma-cli app deploy --framework tanstack-start",
    "compute:open": "prisma-cli app open",
    "compute:logs": "prisma-cli app logs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
